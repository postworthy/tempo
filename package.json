{
  "name": "tempo-template",
  "version": "0.1.0",
  "private": true,
  "description": "Clone-and-start template for human + AI collaboration",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "overrides": {
      "flatted": "3.4.2",
      "picomatch": "4.0.4",
      "postcss": "8.5.18",
      "rollup": "4.59.0",
      "vite": "7.3.5"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit:high": "pnpm audit --audit-level=high",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bootstrap:check": "node scripts/bootstrap-check.mjs",
    "check:contracts": "node scripts/validate-contracts.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:git-policy": "node scripts/check-git-policy.mjs",
    "check:goal": "node scripts/validate-goal.mjs",
    "check:initialized": "node scripts/validate-initialized-state.mjs",
    "check:skills": "node scripts/validate-skills.mjs",
    "goal:status": "node scripts/validate-goal.mjs",
    "intake:scan": "node scripts/intake-scan.mjs",
    "eval": "node scripts/run-evals.mjs",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "pnpm verify:fast && pnpm check:contracts && pnpm check:docs && pnpm check:goal && pnpm check:initialized && pnpm check:skills && pnpm check:git-policy && pnpm test && pnpm eval && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  }
}
